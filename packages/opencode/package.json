{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "7.3.54",
  "name": "@kilocode/cli",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun run script/test-runner.ts",
    "test:ci": "bun run script/test-runner.ts --ci",
    "test:httpapi": "bun run script/httpapi-exercise.ts --mode coverage --fail-on-missing --fail-on-skip && bun run script/httpapi-exercise.ts --mode auth --fail-on-missing --fail-on-skip && bun run script/httpapi-exercise.ts --mode effect --fail-on-missing --fail-on-skip",
    "bench:test": "bun run script/bench-test-suite.ts",
    "profile:test": "bun run script/profile-test-files.ts",
    "build": "bun run script/build.ts",
    "lcm:contracts:generate": "bun run script/lcm-contracts.ts generate",
    "lcm:contracts:check": "bun run script/lcm-contracts.ts check",
    "lcm:migration:smoke": "bun run script/test-runner.ts test/lcm/db-migration.test.ts --timeout 60000 --concurrency 1",
    "lcm:large-file": "bun run script/test-runner.ts test/lcm/large-file.test.ts --timeout 60000 --concurrency 1",
    "lcm:explorer-safety": "bun run script/test-runner.ts test/lcm/file-exploration.test.ts --timeout 60000 --concurrency 1",
    "lcm:map": "bun run script/test-runner.ts test/lcm/map.test.ts --timeout 60000 --concurrency 1",
    "lcm:db:support": "bun run script/test-runner.ts test/lcm/db-smoke.test.ts --timeout 60000 --concurrency 1",
    "lcm:harness:test": "bun run script/test-runner.ts test/lcm/harness.test.ts --timeout 60000 --concurrency 1",
    "lcm:finalized-sync": "bun run script/test-runner.ts test/lcm/finalized-sync.test.ts test/lcm/finalized-sync-retry.test.ts --timeout 60000 --concurrency 1",
    "lcm:recovery:test": "bun run script/test-runner.ts test/lcm/recovery.test.ts test/lcm/db-smoke.test.ts --timeout 60000 --concurrency 1",
    "lcm:active-context:test": "bun run script/test-runner.ts test/lcm/active-context.test.ts --timeout 60000 --concurrency 1",
    "lcm:perf:scale": "bun run script/test-runner.ts test/lcm/active-context.test.ts test/lcm/raw-leaf-parity.test.ts test/lcm/retrieval-tools.test.ts test/lcm/map.test.ts --timeout 60000 --concurrency 1",
    "lcm:render-prep": "bun run script/test-runner.ts test/lcm/render-prep.test.ts --timeout 60000 --concurrency 1",
    "lcm:raw-leaf-parity": "bun run script/test-runner.ts test/lcm/raw-leaf-parity.test.ts --timeout 60000 --concurrency 1",
    "lcm:provider-assembly": "bun run script/test-runner.ts test/lcm/provider-assembly.test.ts --timeout 60000 --concurrency 1",
    "lcm:provider-protocol": "bun run script/test-runner.ts test/lcm/provider-protocol.test.ts --timeout 60000 --concurrency 1",
    "lcm:provider-overflow": "bun run script/test-runner.ts test/kilocode/lcm-provider-overflow.test.ts --timeout 60000 --concurrency 1",
    "lcm:assembly-token-budget": "bun run script/test-runner.ts test/lcm/assembly-token-budget.test.ts --timeout 60000 --concurrency 1",
    "lcm:non-model-leak": "bun run script/test-runner.ts test/lcm/render-prep.test.ts test/lcm/non-model-leak.test.ts --timeout 60000 --concurrency 1",
    "lcm:status-events": "bun run script/test-runner.ts test/lcm/status-events.test.ts --timeout 60000 --concurrency 1",
    "lcm:cutover-quarantine": "bun run script/test-runner.ts test/lcm/cutover-quarantine.test.ts --timeout 60000 --concurrency 1",
    "lcm:release-long-context": "bun run script/lcm-release-long-context.ts --allow-pending-manual --skip-runtime-smoke",
    "lcm:release-long-context:strict": "bun run script/lcm-release-long-context.ts --strict",
    "lcm:platform-runtime-smoke": "bun run script/lcm-platform-packaged-runtime-smoke.ts",
    "lcm:platform-evidence": "bun run script/test-runner.ts test/lcm/platform-evidence.test.ts --timeout 60000 --concurrency 1",
    "lcm:cost": "bun run script/test-runner.ts test/lcm/cost.test.ts --timeout 60000 --concurrency 1",
    "lcm:settings": "bun run script/test-runner.ts test/lcm/settings.test.ts --timeout 60000 --concurrency 1",
    "lcm:recursive-cleanup": "bun test test/lcm/lifecycle.test.ts -t 'recursive deletion cleanup' --timeout 60000",
    "lcm:activation": "bun run script/test-runner.ts test/lcm/lifecycle.test.ts test/lcm/passive-runtime.test.ts test/lcm/preflight-actions.test.ts --timeout 60000 --concurrency 1",
    "lcm:family-runtime": "bun run script/test-runner.ts test/lcm/family-runtime.test.ts --timeout 120000 --concurrency 1",
    "lcm:family-adaptation": "bun run script/lcm-family-adaptation.ts",
    "lcm:context-regression": "bun run script/lcm-context-regression.ts",
    "lcm:detail-recovery-demo": "bun test test/lcm/detail-recovery-demo.test.ts --timeout 60000",
    "lcm:sub-agent-scope": "bun run script/test-runner.ts test/lcm/sub-agent-scope.test.ts --timeout 60000 --concurrency 1",
    "lcm:retrieval-auth": "bun run script/test-runner.ts test/lcm/retrieval-auth.test.ts --timeout 60000 --concurrency 1",
    "lcm:retrieval-tools": "bun run script/test-runner.ts test/lcm/retrieval-tools.test.ts --timeout 60000 --concurrency 1",
    "lcm:path-provenance": "bun run script/test-runner.ts test/lcm/path-provenance.test.ts --timeout 60000 --concurrency 1",
    "lcm:regex-safety": "bun run script/test-runner.ts test/lcm/regex-safety.test.ts --timeout 60000 --concurrency 1",
    "lcm:soft-backlog": "bun run script/test-runner.ts test/lcm/soft-backlog.test.ts --timeout 60000 --concurrency 1",
    "lcm:maintenance-summary-quality": "bun run script/test-runner.ts test/lcm/maintenance-summary-quality.test.ts --timeout 60000 --concurrency 1",
    "lcm:token-budget": "bun run script/test-runner.ts test/lcm/token-budget.test.ts --timeout 60000 --concurrency 1",
    "lcm:scheduler": "bun run script/test-runner.ts test/lcm/scheduler.test.ts --timeout 60000 --concurrency 1",
    "lcm:perf:below-soft": "bun run script/test-runner.ts test/lcm/perf-below-soft.test.ts --timeout 60000 --concurrency 1",
    "lcm:summary": "bun run script/test-runner.ts test/lcm/summary.test.ts --timeout 60000 --concurrency 1",
    "lcm:hard-limit": "bun run script/test-runner.ts test/lcm/hard-limit.test.ts --timeout 60000 --concurrency 1",
    "lcm:crash-reopen": "bun run script/test-runner.ts test/lcm/summary.test.ts test/lcm/hard-limit.test.ts test/lcm/map.test.ts --timeout 60000 --concurrency 1",
    "lcm:prompt-static": "bun run script/lcm-prompt-static-check.ts",
    "lcm:prompt-first-message": "bun test test/session/prompt.test.ts -t 'first plan prompt reaches LLM with LCM render-only reminders' --timeout 120000",
    "lcm:prompt-mcp-schema": "bun test test/session/prompt.test.ts -t 'first prompt resolves MCP tool schemas before LLM' --timeout 120000",
    "lcm:prompt-boundary": "bun run script/test-runner.ts test/lcm/summary.test.ts test/lcm/hard-limit.test.ts test/lcm/retrieval-tools.test.ts test/lcm/system-tool-guide.test.ts --timeout 60000 --concurrency 1",
    "fix-node-pty": "bun run script/fix-node-pty.ts",
    "dev": "bun run --conditions=browser ./src/index.ts",
    "dev:temporary": "bun run --conditions=browser ./src/temporary.ts",
    "db": "bun drizzle-kit"
  },
  "bin": {
    "kilo": "./bin/kilo",
    "kilocode": "./bin/kilo"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "bun": "./src/storage/db.bun.ts",
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.bun.ts"
    },
    "#pty": {
      "bun": "./src/pty/pty.bun.ts",
      "node": "./src/pty/pty.node.ts",
      "default": "./src/pty/pty.bun.ts"
    }
  },
