        "summaryText",
        "candidateSummaryText",
        "sourceText",
        "toolOutput",
        "rawBuildLog",
        "fileBytes",
        "providerErrorText",
        "providerEndpoint"
      ],
      "notesPolicy": "Notes and blockedReason are content-safe operational evidence only; they must not include raw prompt, source, summary, tool output, file, provider endpoint, credential, or provider error text."
