    "fieldSemantics": {
      "providerOutputLimit": "normalized LCM output cap after provider-specific unlimited sentinels, negative values, non-finite values, and absent raw limits have been handled; raw provider option values are forbidden",
      "maintenanceStatusEvidence": "array of content-safe objects with status, phase, reason, workNeeded, workPerformed, and blocking for each required soft/manual/hard status; this replaces a bare observed status list",
      "safeError": "content-safe safe error object; expectedValuesByID safeError.code entries are mandatory exact checks when listed",
      "terminalToolOutputCases": "the long-output preservation check must include completed, terminal_error, and interrupted_error_output cases"
    },
    "globalRequiredFields": ["checkID", "status", "command", "os", "date"],
    "deterministicEvidenceRequires": ["artifactPath"],
    "additionalProperties": false,
