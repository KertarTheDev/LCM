      "failureMode": "unknown_producer_or_missing_cloned_identity_fails_closed"
    },
    {
      "category": "queued_message",
      "sourceRowsRequired": ["kilo_prompt_queue_scope"],
      "queuedVisibility": "visible_only_when_scope_includes_message",
      "derivedProvenancePolicy": "derived_units_with_hidden_queued_provenance_are_excluded_or_fail_closed",
      "modelVisible": true,
      "nonModelSurfacePolicy": "queued_text_forbidden",
